{
  "name": "genesis-editor",
  "version": "0.1.0",
  "description": "A Notion-style block editor for React: slash menu, drag handles, nesting, markdown shortcuts, and image uploads.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumankalia/genesis-editor.git",
    "directory": "packages/editor"
  },
  "homepage": "https://genesis-editor-three.vercel.app",
  "bugs": {
    "url": "https://github.com/sumankalia/genesis-editor/issues"
  },
  "keywords": [
    "react",
    "editor",
    "block-editor",
    "rich-text",
    "notion",
    "wysiwyg",
    "markdown",
    "blocknote",
    "slash-menu"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./parser": {
      "import": {
        "types": "./dist/parser/index.d.ts",
        "default": "./dist/parser/index.js"
      },
      "require": {
        "types": "./dist/parser/index.d.cts",
        "default": "./dist/parser/index.cjs"
      }
    },
    "./parser/linkedom": {
      "import": {
        "types": "./dist/parser/linkedom.d.ts",
        "default": "./dist/parser/linkedom.js"
      },
      "require": {
        "types": "./dist/parser/linkedom.d.cts",
        "default": "./dist/parser/linkedom.cjs"
      }
    },
    "./parser/jsdom": {
      "import": {
        "types": "./dist/parser/jsdom.d.ts",
        "default": "./dist/parser/jsdom.js"
      },
      "require": {
        "types": "./dist/parser/jsdom.d.cts",
        "default": "./dist/parser/jsdom.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "fixtures": "tsx scripts/fixtures.ts",
    "test:node": "node scripts/node-matrix.mjs"
  },
  "peerDependencies": {
    "jsdom": ">=22",
    "linkedom": "^0.18.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@blocknote/core": "~0.56.0",
    "@blocknote/react": "~0.56.0",
    "@blocknote/shadcn": "~0.56.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "linkedom": "^0.18.13",
    "postcss": "^8.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "linkedom": {
      "optional": true
    }
  }
}
